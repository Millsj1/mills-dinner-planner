# Get both values from Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Either key type is supported:
#   - new publishable key:  sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
#   - legacy anon JWT:      eyJhbGciOi... (long base64)
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key
